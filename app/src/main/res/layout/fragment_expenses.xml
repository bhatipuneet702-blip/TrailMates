<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Summary Cards Row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <!-- Total Expenses Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_total_expenses"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/card_balance"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/spacing_lg">

                        <View
                            android:id="@+id/icon_background_food"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/shape_card_background"
                            android:backgroundTint="@color/accent_food_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_category_food"
                            android:contentDescription="@string/total_expenses"
                            app:layout_constraintStart_toStartOf="@id/icon_background_food"
                            app:layout_constraintEnd_toEndOf="@id/icon_background_food"
                            app:layout_constraintTop_toTopOf="@id/icon_background_food"
                            app:layout_constraintBottom_toBottomOf="@id/icon_background_food" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/total_expenses"
                            android:textSize="@dimen/text_size_xs"
                            android:textColor="@color/text_secondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/icon_background_food" />

                        <TextView
                            android:id="@+id/tv_total_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹12,450"
                            android:textSize="@dimen/text_size_lg"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/icon_background_food"
                            app:layout_constraintBottom_toBottomOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Your Balance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_balance"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_total_expenses"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/spacing_lg">

                        <View
                            android:id="@+id/icon_background_people"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/shape_card_background"
                            android:backgroundTint="@color/accent_people_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_add"
                            android:tint="@color/accent_people"
                            android:contentDescription="@string/your_balance"
                            app:layout_constraintStart_toStartOf="@id/icon_background_people"
                            app:layout_constraintEnd_toEndOf="@id/icon_background_people"
                            app:layout_constraintTop_toTopOf="@id/icon_background_people"
                            app:layout_constraintBottom_toBottomOf="@id/icon_background_people" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/your_balance"
                            android:textSize="@dimen/text_size_xs"
                            android:textColor="@color/text_secondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/icon_background_people" />

                        <TextView
                            android:id="@+id/tv_balance_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ ₹620"
                            android:textSize="@dimen/text_size_lg"
                            android:textStyle="bold"
                            android:textColor="@color/success_green"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/icon_background_people"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tv_balance_caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/you_should_receive"
                            android:textSize="@dimen/text_size_xs"
                            android:textColor="@color/text_secondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_balance_amount" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Add Expense Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_expense"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/add_new_expense"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                app:cornerRadius="@dimen/radius_md" />

            <!-- Recent Expenses Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_expenses"
                    android:textSize="@dimen/text_size_md"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textSize="@dimen/text_size_sm"
                    android:textColor="@color/primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Expenses RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_expenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_expense"
                tools:itemCount="4" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_empty_expenses"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:text="@string/no_expenses_yet"
                android:textSize="@dimen/text_size_md"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
