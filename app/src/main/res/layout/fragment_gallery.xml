<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Filter Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_gallery_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_lg"
        app:selectionRequired="true"
        app:singleSelection="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_gallery_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_all"
            android:checked="true"
            app:chipBackgroundColor="@color/secondary"
            app:chipStrokeColor="@color/secondary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_gallery_photos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_photos"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/surface_variant" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_gallery_videos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_videos"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/surface_variant" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_gallery_favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_favorites"
            app:chipBackgroundColor="@color/surface"
            app:chipStrokeColor="@color/surface_variant" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Gallery RecyclerView with Grid Layout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_gallery"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_2xl"
        tools:listitem="@layout/item_gallery"
        tools:itemCount="9"
        app:layout_constraintTop_toBottomOf="@id/chip_group_gallery_filters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_gallery"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:text="@string/no_media_yet"
        android:textSize="@dimen/text_size_md"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/chip_group_gallery_filters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/app_name"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
